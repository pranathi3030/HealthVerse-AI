# PostgreSQL Database Configuration
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=healthverse
DB_USERNAME=postgres
DB_PASSWORD=1234

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017/healthverse

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Eureka / Service Discovery
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/

# Security / JWT
JWT_SECRET=HealthVerseAISecretKeyForJWTAuthentication2026MustBeAtLeast256BitsLong!

# Log Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_HEALTHVERSE=DEBUG
