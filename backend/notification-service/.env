# ==============================================================================
# HealthVerse AI - Notification Service Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthverse
DB_USERNAME=postgres
DB_PASSWORD=1234

# JPA / Hibernate Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# JWT Authentication
JWT_SECRET=HealthVerseAISecretKeyForJWTAuthentication2026MustBeAtLeast256BitsLong!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Eureka Discovery Server
EUREKA_HOSTNAME=localhost
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Service Ports
PORT=8088

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_HEALTHVERSE=DEBUG
